# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore all environment files.
/.env*
!/.env.example

# Ignore runtime logs, temporary files, and local storage.
/log/*
/tmp/*
/storage/*

# Node
/node_modules
/server/node_modules
/server/dist
/.vite/
AGENTS.md
/dist
/public/assets
/public/index.html
/vite-screenshot.log
/vite-dev.log
/vite-dev-error.log
/.tmp-make-*
/tsconfig.app.tsbuildinfo
/tsconfig.node.tsbuildinfo
/vite.config.js
/vite.config.d.ts
/playwright.config.js
/playwright.config.d.ts
/e2e/*.js
/e2e/*.d.ts
/playwright-report
/test-results
/AGENTS.local.md
/.claude/

# Local dev utilities (not product code)
/scripts/dump-diff.ps1
/scripts/dump-diff.sh

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
*.tfplan
